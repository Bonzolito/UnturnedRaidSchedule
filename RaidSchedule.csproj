<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>RaidSchedule</RootNamespace>
    <AssemblyName>RaidSchedule</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Verify versions against the OpenMod release matching your server install. -->
    <PackageReference Include="OpenMod.Unturned" Version="3.8.10" PrivateAssets="all" />
    <PackageReference Include="TimeZoneConverter" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.yaml">
      <CopyToOutputDirectory>PreserveNewestIfNewer</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>